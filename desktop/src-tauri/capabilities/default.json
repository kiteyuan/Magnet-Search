{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the Magnet web shell main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://magnet.kiteyuan.info",
      "https://magnet.kiteyuan.info/**",
      "https://*.kiteyuan.info",
      "https://*.kiteyuan.info/**"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default"
  ]
}
